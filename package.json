{
  "name": "wt-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoring application for The Weekly Thing",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "node --import tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "better-sqlite3": "^12.2.0",
    "preact": "^10.27.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
