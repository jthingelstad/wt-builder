# WT Builder needs three credentials. Everything else in a copied Studio .env
# is unused here and is worth deleting rather than leaving in the directory.

# Pinboard: "username:HEX". Both halves are needed — the username builds
# bookmark permalinks. Read scopes the unread queue; writing is opt-in below.
PINBOARD_API_TOKEN=

# Buttondown: creates and updates the issue draft. Never schedules or sends.
BUTTONDOWN_API_KEY=

# Micro.blog: required. Reads post *source* (the exact Markdown) through
# Micropub q=source, and the same endpoint updates a post. Note that
# /posts/all is the *timeline* — everyone Jamie follows — and must never be
# swept into an issue.
MICROBLOG_API_KEY=

# ── options ────────────────────────────────────────────────────────────────

# Where Jamie's posts are read from.
MICROBLOG_BLOG_URL=https://www.thingelstad.com

# Write-back is last-writer-wins and mutates the real bookmark / published
# post. A failed write never discards the local edit.
WT_BUILDER_PINBOARD_WRITEBACK=true
WT_BUILDER_MICROBLOG_WRITEBACK=true

# Copy remote images to files.thingelstad.com, resized, before sending.
# Micro.blog serves originals: a photo shown at 600px arrives as a 2.6 MB
# 1800x1350 JPEG, which is what makes an email enormous.
WT_BUILDER_REHOST_IMAGES=true

# Rehosting and the audio upload write to the files.thingelstad.com bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# The website send commits generated 11ty inputs to the render surface.
# Fine-grained PAT, Contents: write on that repo only.
GITHUB_PAT_TOKEN=
GITHUB_REPO_NWO=jthingelstad/weekly.thingelstad.com

# Text-to-speech for the audio edition: OpenAI tts-1-hd, voice "echo",
# matching what Studio has shipped for years. Needs ffmpeg and ffprobe on PATH.
OPENAI_API_KEY=
# Standing intro/outro bumpers wrapped around the body, if you have them.
# Studio's live in studio-thing/data/audio/bumpers/.
WT_BUILDER_BUMPERS_DIR=

# Audio is mastered to the podcast convention: two-pass loudnorm to -16 LUFS
# / -1.5 dBTP, an 80Hz highpass, mono 44.1kHz at 192k, ID3v2.3 tags, and the
# issue cover embedded as attached art. Show art fallback: assets/podcast-cover.png.

# Editorial review and drafting.
ANTHROPIC_API_KEY=

# Loopback by default: Tailscale terminates identity in front of this process,
# and there is no auth layer here. Do not bind 0.0.0.0.
WT_BUILDER_HOST=127.0.0.1
WT_BUILDER_PORT=4317
WT_BUILDER_DB=./data/wt-builder.db

# The last issue published before WT Builder. Pre-Builder issues are not
# imported as items (0020), so this is how numbering continues from them.
WT_BUILDER_LAST_PUBLISHED_ISSUE=349
