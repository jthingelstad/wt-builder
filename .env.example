# WT Builder needs three credentials. Everything else in a copied Studio .env
# is unused here and is worth deleting rather than leaving in the directory.

# Pinboard: "username:HEX". Both halves are needed — the username builds
# bookmark permalinks. Read scopes the unread queue; writing is opt-in below.
PINBOARD_API_TOKEN=

# Buttondown: creates and updates the issue draft. Never schedules or sends.
BUTTONDOWN_API_KEY=

# Micro.blog: not currently required. Jamie's posts are read from the blog's
# public JSON Feed, which is authoritative for his own writing. Micro.blog's
# /posts/all is the *timeline* (everyone he follows) and must not be swept.
MICROBLOG_API_KEY=

# ── options ────────────────────────────────────────────────────────────────

# Where Jamie's posts are read from.
MICROBLOG_BLOG_URL=https://www.thingelstad.com

# Pinboard write-back mutates real bookmarks (last-writer-wins on title,
# commentary, and tags). Off unless you turn it on deliberately.
WT_BUILDER_PINBOARD_WRITEBACK=false

# Loopback by default: Tailscale terminates identity in front of this process,
# and there is no auth layer here. Do not bind 0.0.0.0.
WT_BUILDER_HOST=127.0.0.1
WT_BUILDER_PORT=4317
WT_BUILDER_DB=./data/wt-builder.db
